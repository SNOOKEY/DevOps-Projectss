pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo "Repository checked out successfully."
            }
        }

        stage('Build') {
            steps {
                dir('DevOps-Project-38/FullStack-Blogging-App') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
    }
}